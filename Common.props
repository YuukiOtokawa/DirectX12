<?xml version="1.0" encoding="utf-8"?>
<!--
  エンジンの各プロジェクト（Core / Editor / AsteroidEditor、将来の AsteroidPlayer）で共通のビルド設定。
  モジュールをまたいで STL を受け渡すので、CRT（/MD）・文字セット・言語標準などは必ず全プロジェクトで揃える。
  文字セット（CharacterSet）と WholeProgramOptimization は Microsoft.Cpp.props より前に必要なので、各 .vcxproj 側で指定する。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AsteroidRoot>$(MSBuildThisFileDirectory)</AsteroidRoot>
    <OutDir>$(AsteroidRoot)Build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(AsteroidRoot)Build\$(Platform)\$(Configuration)\Intermediate\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>_WINDOWS;YAML_CPP_STATIC_DEFINE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(AsteroidRoot)Code\Component;$(AsteroidRoot)Code;$(AsteroidRoot);$(AsteroidRoot)yaml-cpp\Code;$(AsteroidRoot)Code\Render;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
